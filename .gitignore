# .gitignore for BE Workspace

# Exclude all images by default
images/*

# Track Alloy classification project under images/
!images/Alloy_Class/
!images/Alloy_Class/**

# But keep sample Alloy inputs and thumbnail junk out of git
images/Alloy_Class/inputs/
images/Alloy_Class/**/Thumbs.db
images/Alloy_Class/outputs/

# Exclude common large file types
*.zip
*.tar
*.gz
*.7z
*.rar
*.iso
*.bin
*.exe
*.dll
*.mp4
*.mov
*.avi
*.mkv
*.wav
*.mp3
*.bak
*.tmp
*.log

# Exclude outputs, debug logs, and old/archived work
outputs/
debug_logs/
OLD/
rollups/
html/SS_Subentity_Reports/
html/Inline_Subentity_Reports/
html/adhoc_chamber_events/
html/adhoc_elements/

# Allow manifest and artifacts
!artifacts/*.json

# Node, Python, and editor junk
__pycache__/
*.pyc
.vscode/
~$*
